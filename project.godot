; Engine configuration file.
; Best edited using the Godot editor.
config_version=5

[application]

config/name="VCommander"
config/version="0.16.1"
run/main_scene="res://scenes/main_menu/main_menu.tscn"

[autoload]

ContentDatabase="*res://scripts/core/content_database.gd"
GameState="*res://scripts/core/game_state.gd"
GameAudio="*res://scripts/presentation/game_audio.gd"
GameMenu="*res://scripts/presentation/game_menu.gd"
OnlineSession="*res://scripts/network/online_session.gd"
FirstMatchGuide="*res://scripts/presentation/first_match_guide.gd"

[network]

private_room_url="wss://vcommander-friend-playtest.onrender.com"

[development]

collection_key_sha256="ed21fd9b862ce47eb1b0305527a7337750259eb1ce5312d83dac8bd984d092ea"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.059, 0.075, 1)

[gui]

theme/custom="res://assets/ui/fantasy_theme.tres"
