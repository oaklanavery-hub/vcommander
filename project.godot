; Engine configuration file.
; Best edited using the Godot editor.
config_version=5

[application]

config/name="VCommander"
config/version="0.8.1"
run/main_scene="res://scenes/main_menu/main_menu.tscn"

[autoload]

ContentDatabase="*res://scripts/core/content_database.gd"
GameState="*res://scripts/core/game_state.gd"
GameAudio="*res://scripts/presentation/game_audio.gd"
GameMenu="*res://scripts/presentation/game_menu.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.059, 0.075, 1)

[gui]

theme/custom="res://assets/ui/fantasy_theme.tres"
