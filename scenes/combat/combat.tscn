[gd_scene load_steps=3 format=3]

[ext_resource path="res://scripts/combat/combat_screen.gd" type="Script" id="1"]
[ext_resource path="res://scripts/combat/battlefield_view.gd" type="Script" id="2"]

[node name="Combat" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 30.0
offset_top = 20.0
offset_right = -30.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2

[node name="Main" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Margin/Main"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Back" type="Button" parent="Margin/Main/Header"]
custom_minimum_size = Vector2(110, 42)
layout_mode = 2
text = "← Draft"

[node name="Title" type="Label" parent="Margin/Main/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 30
text = "Battle 1 • The Verdant Crossing"
horizontal_alignment = 1

[node name="Seed" type="Label" parent="Margin/Main/Header"]
layout_mode = 2
custom_minimum_size = Vector2(150, 0)
text = "Seed"
horizontal_alignment = 2
vertical_alignment = 1

[node name="StatusRow" type="HBoxContainer" parent="Margin/Main"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BattleTimer" type="Label" parent="Margin/Main/StatusRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Battle 000.0 / 000.0 sec"

[node name="Speed" type="Button" parent="Margin/Main/StatusRow"]
custom_minimum_size = Vector2(170, 38)
layout_mode = 2
text = "Replay speed: 2x"

[node name="Skip" type="Button" parent="Margin/Main/StatusRow"]
custom_minimum_size = Vector2(150, 38)
layout_mode = 2
text = "Skip to Result"

[node name="BattlePanel" type="PanelContainer" parent="Margin/Main"]
custom_minimum_size = Vector2(0, 360)
layout_mode = 2
